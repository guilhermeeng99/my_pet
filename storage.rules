rules_version = '2';

// Regras de segurança Firebase Storage para my_pet.
//
// Estrutura:
//   households/{householdId}/pets/{petId}/profile.jpg
//   households/{householdId}/pets/{petId}/gallery/{photoId}/original.jpg
//   households/{householdId}/pets/{petId}/gallery/{photoId}/thumb.jpg
//   households/{householdId}/pets/{petId}/health/{eventId}/{filename}
//   households/{householdId}/documents/{documentId}.{ext}
//
// Apenas membros da household podem ler/escrever os arquivos da sua household.
//
// Limites de tamanho aplicados aqui também (defesa em profundidade).

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Lê o doc da household no Firestore para validar membership.
    function isMember(hid) {
      return isSignedIn() &&
             firestore.exists(/databases/(default)/documents/households/$(hid)) &&
             uid() in firestore.get(/databases/(default)/documents/households/$(hid)).data.memberIds;
    }

    // Tudo que está dentro de households/{hid}/...
    //
    // TODO: tighten back to `isMember(hid)` once the cross-service IAM is
    // fixed. Storage Rules' `firestore.get()` lookup currently returns
    // permission-denied on this project (newer `.firebasestorage.app`
    // bucket), so the membership check fails on read. Tracking the IAM
    // role binding (Firebase Rules System on the Cloud Storage SA) as a
    // follow-up; until then any signed-in user of the project can read
    // household assets.
    match /households/{hid}/{allPaths=**} {
      allow read: if isSignedIn();
    }

    // Foto de perfil do pet — máx 2MB, jpeg/png.
    //
    // TODO: tighten back to `isMember(hid)` once the cross-service IAM
    // permission for Storage → Firestore lookups is in place (see the
    // matching note on the parent `match` above).
    match /households/{hid}/pets/{petId}/profile.jpg {
      allow write: if isSignedIn()
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Galeria — máx 5MB por arquivo (original + thumb sob o mesmo photoId)
    match /households/{hid}/pets/{petId}/gallery/{photoId}/{filename} {
      allow write: if isMember(hid)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Anexos de eventos de saúde — máx 10MB por arquivo
    match /households/{hid}/pets/{petId}/health/{eventId}/{filename} {
      allow write: if isMember(hid)
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Documentos — máx 20MB
    match /households/{hid}/documents/{documentId} {
      allow write: if isMember(hid)
                   && request.resource.size < 20 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
