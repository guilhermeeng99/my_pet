# ───────────────────────────────────────────────────────────────────
# Firebase / secrets — this repo is PUBLIC.
# Never commit any of the files below. Each fork generates its own
# via `flutterfire configure`. See SETUP.md.
# ───────────────────────────────────────────────────────────────────

# FlutterFire generated config (contains API keys / app IDs)
lib/firebase_options.dart

# Android Firebase config
android/app/google-services.json
android/key.properties
**/*.jks
**/*.keystore

# iOS / macOS Firebase config
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
macos/Runner/GoogleService-Info.plist
macos/firebase_app_id_file.json

# Firebase CLI / hosting / functions
.firebase/
.firebaserc
firebase.json
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# Service accounts (NEVER commit these — full project access)
*-service-account*.json
*service_account*.json
serviceAccountKey*.json

# Environment files
.env
.env.local
.env.*.local

# Generated code (regenerated by build_runner)
**/*.g.dart
**/*.freezed.dart
**/*.config.dart
**/*.gen.dart
lib/gen/strings.g.dart
