rules_version = '2';

// TEMPORARY DEV RULES — looser than production-grade so app testing isn't
// blocked by rule-evaluation edge cases. Authenticated users can read/write
// their own profile, any household subtree, and invite codes. To be tightened
// to the household-scoped per-action rules once UI testing is done.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSelf(userId) { return isSignedIn() && uid() == userId; }

    match /users/{userId} {
      // Self-read/write for own profile. Other signed-in users can READ to
      // power the household-members screen (TEMP DEV: tightened later to
      // members-of-same-household once we re-introduce the strict ruleset).
      allow read: if isSignedIn();
      allow create, delete: if isSelf(userId);
      // Self can update freely. Anyone else can update only the
      // `householdId` field — the owner-removes-partner flow flips the
      // partner's `householdId` to null. Owner-must-be-actor is enforced
      // in the datasource (HouseholdFirestoreDatasource.removeMember
      // throws NotOwnerException) before the batched write fires; the
      // rule just has to permit the cross-user write itself.
      allow update: if isSelf(userId) || (
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId'])
      );
      match /fcmTokens/{tokenId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /households/{hid} {
      allow read, write: if isSignedIn();
      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /inviteCodes/{code} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
